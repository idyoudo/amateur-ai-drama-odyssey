# AADO 数据库（独立于 retail 的 RTO 库与 dev 账号）
# 部署脚本会在远端 .env 缺失时用 openssl rand -hex 24 生成 POSTGRES_PASSWORD；.env 一律不入 Git
POSTGRES_PASSWORD=change-me
# 容器内连接串（compose 服务名 postgres）
DATABASE_URL=postgres://aado:change-me@postgres:5432/AADO
# 宿主机连接串（外部工具连宿主 5433）
DATABASE_URL_HOST=postgres://aado:change-me@localhost:5433/AADO

# ===== 模型参数（后续由用户提供；也可在页面 /models 配置）=====
# 每个 kind 三项：MODEL（模型名）/ API_KEY / API_URL；缺一则该 kind 走 Mock
TEXT_MODEL=
TEXT_API_KEY=
TEXT_API_URL=
VIDEO_MODEL=
VIDEO_API_KEY=
VIDEO_API_URL=
IMAGE_MODEL=
IMAGE_API_KEY=
IMAGE_API_URL=
TTS_MODEL=
TTS_API_KEY=
TTS_API_URL=
MUSIC_MODEL=
MUSIC_API_KEY=
MUSIC_API_URL=
LIPSYNC_MODEL=
LIPSYNC_API_KEY=
LIPSYNC_API_URL=
